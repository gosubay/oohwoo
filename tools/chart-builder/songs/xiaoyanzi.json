  {
   "id": "zh",
   "language": "zh",
   "start": 11.0,
   "end": 67.0,
   "verses": [
    {
     "label": "Verse 1",
     "lines": [
      "小燕子，穿花衣，",
      "年年春天来这里。",
      "我问燕子你为啥来？",
      "燕子说：“这里的春天最美丽。”"
     ]
    },
    {
     "label": "Verse 2",
     "lines": [
      "小燕子，告诉你，",
      "今年这里更美丽。",
      "我们盖起了大工厂，",
      "装上了新机器。",
      "欢迎你，长期住在这里。"
     ]
    }
   ]
  },
  {
   "id": "en",
   "language": "en",
   "start": 92.5,
   "end": 152.0,
   "verses": [
    {
     "label": "Verse 3",
     "lines": [
      "Little bird, coat of flowers",
      "Greeting me through spring showers",
      "Little bird, why are you here?",
      "The spring here is the prettiest I’ve seen"
     ]
    },
    {
     "label": "Verse 4",
     "lines": [
      "Little bird, I’ve news for you",
      "This place is more beautiful too",
      "We built a big factory",
      "Filled with machinery",
      "Feel free to stay here indefinitely"
     ]
    }
   ]
  },
